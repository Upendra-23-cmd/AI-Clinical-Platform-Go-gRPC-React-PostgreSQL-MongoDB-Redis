# ============================================================
#  HealthOS — Environment Variables
#  Copy this file to .env in each service directory and fill
#  in values. NEVER commit real secrets to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development          # development | production
SERVICE_NAME=healthos        # overridden per service

# ── gRPC / HTTP ports ────────────────────────────────────────
# patient-service
PATIENT_GRPC_PORT=50051
PATIENT_HTTP_PORT=8081

# appointment-service
APPOINTMENT_GRPC_PORT=50052
APPOINTMENT_HTTP_PORT=8082

# ai-diagnostic-service
DIAGNOSTIC_GRPC_PORT=50053
DIAGNOSTIC_HTTP_PORT=8083

# notification-service
NOTIFICATION_GRPC_PORT=50054
NOTIFICATION_HTTP_PORT=8084

# analytics-service
ANALYTICS_GRPC_PORT=50055
ANALYTICS_HTTP_PORT=8085

# gateway
GATEWAY_HTTP_PORT=8080

# ── PostgreSQL (patient-service) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthos
POSTGRES_PASSWORD=healthos_dev_secret
POSTGRES_DB=healthos
POSTGRES_SSLMODE=disable

# ── MongoDB (appointment-service, analytics-service) ─────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=healthos

# ── Redis (cache + pub/sub) ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random secret in production (32+ chars)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRATION=24h

# ── AI Provider (Anthropic) ───────────────────────────────────
AI_PROVIDER_URL=https://api.anthropic.com
AI_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
AI_MODEL=claude-sonnet-4-20250514

# ── Inter-service addresses (for gateway) ────────────────────
PATIENT_SERVICE_ADDR=localhost:50051
APPOINTMENT_SERVICE_ADDR=localhost:50052
DIAGNOSTIC_SERVICE_ADDR=localhost:50053
NOTIFICATION_SERVICE_ADDR=localhost:50054
ANALYTICS_SERVICE_ADDR=localhost:50055

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
